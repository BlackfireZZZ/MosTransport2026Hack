# Origin of the FastAPI backend that `npm run dev` proxies /api to.
# Default when unset: http://127.0.0.1:8010
# (8000 is deliberately avoided -- an unrelated app owns it on the dev machine.)
VITE_API_PROXY_TARGET=http://127.0.0.1:8010

# Port for the Vite dev server itself. Default: 5173
VITE_DEV_PORT=5173
