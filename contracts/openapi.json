{
  "components": {
    "schemas": {
      "ForecastHorizon": {
        "enum": [
          "day",
          "month",
          "year"
        ],
        "title": "ForecastHorizon",
        "type": "string"
      },
      "ForecastPointResponse": {
        "properties": {
          "capacity": {
            "exclusiveMinimum": 0.0,
            "title": "Capacity",
            "type": "number"
          },
          "lower_bound": {
            "minimum": 0.0,
            "title": "Lower Bound",
            "type": "number"
          },
          "predicted_passengers": {
            "minimum": 0.0,
            "title": "Predicted Passengers",
            "type": "number"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "upper_bound": {
            "minimum": 0.0,
            "title": "Upper Bound",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "predicted_passengers",
          "lower_bound",
          "upper_bound",
          "capacity"
        ],
        "title": "ForecastPointResponse",
        "type": "object"
      },
      "ForecastResponse": {
        "properties": {
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "horizon": {
            "$ref": "#/components/schemas/ForecastHorizon"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "peak_load_percent": {
            "title": "Peak Load Percent",
            "type": "number"
          },
          "peak_passengers": {
            "title": "Peak Passengers",
            "type": "number"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ForecastPointResponse"
            },
            "title": "Points",
            "type": "array"
          },
          "route": {
            "$ref": "#/components/schemas/RouteResponse"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/StopLoadResponse"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "route",
          "horizon",
          "generated_at",
          "model_version",
          "peak_passengers",
          "peak_load_percent",
          "points",
          "stops"
        ],
        "title": "ForecastResponse",
        "type": "object"
      },
      "GeoJsonMetadataResponse": {
        "properties": {
          "area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area"
          },
          "filtered_to_route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filtered To Route"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated At"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "osm_data_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Osm Data Timestamp"
          },
          "route_relations": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Relations"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "title": "GeoJsonMetadataResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LineStringGeometry": {
        "properties": {
          "coordinates": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "LineString",
            "default": "LineString",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "LineStringGeometry",
        "type": "object"
      },
      "NeighbourDirection": {
        "enum": [
          "in",
          "out"
        ],
        "title": "NeighbourDirection",
        "type": "string"
      },
      "NetworkComponentResponse": {
        "properties": {
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          },
          "size": {
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "size",
          "routes"
        ],
        "title": "NetworkComponentResponse",
        "type": "object"
      },
      "NetworkStatsResponse": {
        "properties": {
          "components": {
            "description": "Undirected components, largest first; the network really is in two pieces",
            "items": {
              "$ref": "#/components/schemas/NetworkComponentResponse"
            },
            "title": "Components",
            "type": "array"
          },
          "degree_histogram": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Degree Histogram",
            "type": "object"
          },
          "edges": {
            "description": "Directed edges; a pair served both ways counts twice",
            "title": "Edges",
            "type": "integer"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated At"
          },
          "osm_data_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Osm Data Timestamp"
          },
          "route_relations": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "PTv2 route relations in the OSM extract, one per direction. A larger number than `routes`, and not interchangeable with it.",
            "title": "Route Relations"
          },
          "routes": {
            "description": "Distinct route refs",
            "title": "Routes",
            "type": "integer"
          },
          "segment_length_m": {
            "$ref": "#/components/schemas/SegmentLengthSummaryResponse"
          },
          "stops": {
            "title": "Stops",
            "type": "integer"
          },
          "total_length_km": {
            "title": "Total Length Km",
            "type": "number"
          }
        },
        "required": [
          "stops",
          "edges",
          "routes",
          "total_length_km",
          "components",
          "degree_histogram",
          "segment_length_m"
        ],
        "title": "NetworkStatsResponse",
        "type": "object"
      },
      "OverpassQueryRequest": {
        "properties": {
          "query": {
            "description": "Overpass QL. The length ceiling is a runtime setting, not part of this schema.",
            "examples": [
              "[out:json][timeout:60];node(1);out;"
            ],
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "OverpassQueryRequest",
        "type": "object"
      },
      "OverpassQueryResponse": {
        "properties": {
          "remark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when Overpass answered 200 with a PARTIAL result because the query hit its own [timeout:]. Lifted out of `result` so it cannot be missed; treating such a response as complete is the easiest way to publish wrong numbers.",
            "title": "Remark"
          },
          "result": {
            "additionalProperties": true,
            "description": "The Overpass JSON document, unmodified",
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "title": "OverpassQueryResponse",
        "type": "object"
      },
      "OverpassStatusResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the probe failed; null when the instance answered",
            "title": "Detail"
          },
          "reachable": {
            "title": "Reachable",
            "type": "boolean"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "reachable"
        ],
        "title": "OverpassStatusResponse",
        "type": "object"
      },
      "PathAbsence": {
        "description": "Why no path was returned, in a form a client can branch on.",
        "enum": [
          "unknown_stop",
          "different_components",
          "wrong_direction"
        ],
        "title": "PathAbsence",
        "type": "string"
      },
      "PointGeometry": {
        "properties": {
          "coordinates": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "default": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "PointGeometry",
        "type": "object"
      },
      "RouteDetailResponse": {
        "properties": {
          "component": {
            "minimum": 0.0,
            "title": "Component",
            "type": "integer"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/TramEdgeResponse"
            },
            "title": "Edges",
            "type": "array"
          },
          "length_m": {
            "minimum": 0.0,
            "title": "Length M",
            "type": "number"
          },
          "ref": {
            "title": "Ref",
            "type": "string"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/TramStopResponse"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "ref",
          "stops",
          "edges",
          "length_m",
          "component"
        ],
        "title": "RouteDetailResponse",
        "type": "object"
      },
      "RouteResponse": {
        "properties": {
          "color": {
            "title": "Color",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "name",
          "color"
        ],
        "title": "RouteResponse",
        "type": "object"
      },
      "ScenarioRequest": {
        "properties": {
          "additional_vehicles": {
            "default": 0,
            "maximum": 20.0,
            "minimum": -5.0,
            "title": "Additional Vehicles",
            "type": "integer"
          },
          "demand_change_percent": {
            "default": 0,
            "maximum": 300.0,
            "minimum": -90.0,
            "title": "Demand Change Percent",
            "type": "number"
          },
          "horizon": {
            "$ref": "#/components/schemas/ForecastHorizon",
            "default": "day"
          },
          "interval_change_percent": {
            "default": 0,
            "maximum": 200.0,
            "minimum": -75.0,
            "title": "Interval Change Percent",
            "type": "number"
          },
          "route_id": {
            "exclusiveMinimum": 0.0,
            "title": "Route Id",
            "type": "integer"
          }
        },
        "required": [
          "route_id"
        ],
        "title": "ScenarioRequest",
        "type": "object"
      },
      "ScenarioResponse": {
        "properties": {
          "affected_stops": {
            "items": {
              "$ref": "#/components/schemas/StopLoadResponse"
            },
            "title": "Affected Stops",
            "type": "array"
          },
          "baseline_peak_load_percent": {
            "title": "Baseline Peak Load Percent",
            "type": "number"
          },
          "capacity_delta": {
            "title": "Capacity Delta",
            "type": "number"
          },
          "passenger_delta": {
            "title": "Passenger Delta",
            "type": "number"
          },
          "scenario_peak_load_percent": {
            "title": "Scenario Peak Load Percent",
            "type": "number"
          },
          "solver_version": {
            "title": "Solver Version",
            "type": "string"
          }
        },
        "required": [
          "baseline_peak_load_percent",
          "scenario_peak_load_percent",
          "passenger_delta",
          "capacity_delta",
          "affected_stops",
          "solver_version"
        ],
        "title": "ScenarioResponse",
        "type": "object"
      },
      "SegmentFeature": {
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/LineStringGeometry"
          },
          "properties": {
            "$ref": "#/components/schemas/SegmentFeatureProperties"
          },
          "type": {
            "const": "Feature",
            "default": "Feature",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "geometry",
          "properties"
        ],
        "title": "SegmentFeature",
        "type": "object"
      },
      "SegmentFeatureProperties": {
        "properties": {
          "length_m": {
            "title": "Length M",
            "type": "number"
          },
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "integer"
          },
          "target": {
            "title": "Target",
            "type": "integer"
          }
        },
        "required": [
          "source",
          "target",
          "length_m",
          "routes"
        ],
        "title": "SegmentFeatureProperties",
        "type": "object"
      },
      "SegmentLengthSummaryResponse": {
        "properties": {
          "max": {
            "title": "Max",
            "type": "number"
          },
          "mean": {
            "title": "Mean",
            "type": "number"
          },
          "median": {
            "title": "Median",
            "type": "number"
          },
          "min": {
            "title": "Min",
            "type": "number"
          }
        },
        "required": [
          "min",
          "median",
          "mean",
          "max"
        ],
        "title": "SegmentLengthSummaryResponse",
        "type": "object"
      },
      "StopDetailResponse": {
        "properties": {
          "id": {
            "description": "OSM stop_position node id",
            "title": "Id",
            "type": "integer"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "neighbours": {
            "items": {
              "$ref": "#/components/schemas/StopNeighbourResponse"
            },
            "title": "Neighbours",
            "type": "array"
          },
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "routes",
          "neighbours"
        ],
        "title": "StopDetailResponse",
        "type": "object"
      },
      "StopFeature": {
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/PointGeometry"
          },
          "properties": {
            "$ref": "#/components/schemas/StopFeatureProperties"
          },
          "type": {
            "const": "Feature",
            "default": "Feature",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "geometry",
          "properties"
        ],
        "title": "StopFeature",
        "type": "object"
      },
      "StopFeatureProperties": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "routes"
        ],
        "title": "StopFeatureProperties",
        "type": "object"
      },
      "StopLoadResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "load_percent": {
            "minimum": 0.0,
            "title": "Load Percent",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "predicted_passengers": {
            "minimum": 0.0,
            "title": "Predicted Passengers",
            "type": "number"
          },
          "sequence": {
            "minimum": 1.0,
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "predicted_passengers",
          "load_percent",
          "sequence"
        ],
        "title": "StopLoadResponse",
        "type": "object"
      },
      "StopNeighbourResponse": {
        "properties": {
          "direction": {
            "$ref": "#/components/schemas/NeighbourDirection"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "length_m": {
            "minimum": 0.0,
            "title": "Length M",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "length_m",
          "routes",
          "direction"
        ],
        "title": "StopNeighbourResponse",
        "type": "object"
      },
      "TramEdgeResponse": {
        "properties": {
          "length_m": {
            "description": "Metres along the track, not as the crow flies",
            "minimum": 0.0,
            "title": "Length M",
            "type": "number"
          },
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "integer"
          },
          "target": {
            "title": "Target",
            "type": "integer"
          }
        },
        "required": [
          "source",
          "target",
          "length_m",
          "routes"
        ],
        "title": "TramEdgeResponse",
        "type": "object"
      },
      "TramGraphGeoJson": {
        "description": "A GeoJSON FeatureCollection: stops as Points, track segments as LineStrings.",
        "properties": {
          "features": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/StopFeature"
                },
                {
                  "$ref": "#/components/schemas/SegmentFeature"
                }
              ]
            },
            "title": "Features",
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/GeoJsonMetadataResponse"
          },
          "type": {
            "const": "FeatureCollection",
            "default": "FeatureCollection",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "metadata",
          "features"
        ],
        "title": "TramGraphGeoJson",
        "type": "object"
      },
      "TramPathResponse": {
        "properties": {
          "found": {
            "title": "Found",
            "type": "boolean"
          },
          "geometry": {
            "description": "[lon, lat] pairs along the track",
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Geometry",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The same cause in English prose, for a human reading the API directly.",
            "title": "Reason"
          },
          "reason_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PathAbsence"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why there is no such ride, as a value a client can branch on. Present with `found=false`, which is a 200. Prefer this over `reason` for anything the user sees: `reason` is English prose."
          },
          "routes": {
            "items": {
              "type": "string"
            },
            "title": "Routes",
            "type": "array"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/TramStopResponse"
            },
            "title": "Stops",
            "type": "array"
          },
          "total_length_m": {
            "minimum": 0.0,
            "title": "Total Length M",
            "type": "number"
          }
        },
        "required": [
          "found",
          "stops",
          "total_length_m",
          "geometry",
          "routes"
        ],
        "title": "TramPathResponse",
        "type": "object"
      },
      "TramRouteResponse": {
        "properties": {
          "component": {
            "description": "0 is the main network, 1 the northern one",
            "minimum": 0.0,
            "title": "Component",
            "type": "integer"
          },
          "length_m": {
            "minimum": 0.0,
            "title": "Length M",
            "type": "number"
          },
          "ref": {
            "description": "Route ref as OSM carries it; not always numeric (\"А\", \"т1\")",
            "title": "Ref",
            "type": "string"
          },
          "stop_count": {
            "minimum": 0.0,
            "title": "Stop Count",
            "type": "integer"
          }
        },
        "required": [
          "ref",
          "stop_count",
          "length_m",
          "component"
        ],
        "title": "TramRouteResponse",
        "type": "object"
      },
      "TramStopResponse": {
        "description": "`latitude`/`longitude`, matching the forecast slice's StopResponse.\n\nThe committed graph files call these `lat`/`lon`; that spelling stops at the\nrepository, so one API does not expose two names for one concept. Original\ndocstring follows.\n\nThese are the field names in\n`docs/tram-graph.md`, the committed GeoJSON and every map library.",
        "properties": {
          "id": {
            "description": "OSM stop_position node id",
            "title": "Id",
            "type": "integer"
          },
